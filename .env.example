# Copy to .env and fill in. .env is gitignored — never commit real values.

# Discord application credentials (Developer Portal -> your app)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: register slash commands to one guild for instant availability
# during development. Leave blank to register globally (can take ~1 hour).
DISCORD_GUILD_ID=

# Optional: where per-guild config is stored. Leave blank to use ./config.
# Hosted, point this at persistent storage or every deploy wipes your settings
# (on Render, a mounted disk — e.g. /data/config).
CONFIG_DIR=
